# ============ LLM — bring your own API and model ============
# Talon works on any LLM you choose. Pick a provider (the API) and a model.

# Provider: "anthropic" (default) or "openai" (works with ANY OpenAI-compatible
# endpoint: OpenAI, Groq, Ollama, OpenRouter, Together, DeepSeek, Gemini's
# compatibility endpoint, LM Studio, vLLM, ...)
LLM_PROVIDER=anthropic

# API key for your chosen provider.
# (ANTHROPIC_API_KEY / OPENAI_API_KEY also work as fallbacks.)
LLM_API_KEY=sk-...

# Model — any model your provider serves.
# anthropic default: claude-opus-4-8
# openai default:    gpt-4o
LLM_MODEL=claude-opus-4-8

# Base URL override — required for non-OpenAI compatible providers, e.g.:
#   Groq:       https://api.groq.com/openai/v1
#   Ollama:     http://localhost:11434/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
# LLM_BASE_URL=

# ============ Talon settings (optional, defaults shown) ============
# TALON_NAME=Talon
# TALON_DATA_DIR=./data
# TALON_TIMEZONE=Europe/London
# TALON_DIGEST_TIME=07:30
# TALON_COMMITMENT_SCAN_MIN=15
# TALON_LOG_LEVEL=info

# ============ Google Calendar (optional) ============
# OAuth refresh-token flow. Create OAuth credentials in Google Cloud Console
# with the https://www.googleapis.com/auth/calendar scope, then obtain a
# refresh token (e.g. via https://developers.google.com/oauthplayground).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
