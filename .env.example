# Required — your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults shown
# TALON_MODEL=claude-opus-4-8
# TALON_NAME=Talon
# TALON_DATA_DIR=./data
# TALON_TIMEZONE=Europe/London
# TALON_DIGEST_TIME=07:30
# TALON_COMMITMENT_SCAN_MIN=15
# TALON_LOG_LEVEL=info

# Optional — Google Calendar (OAuth refresh-token flow).
# Create OAuth credentials in Google Cloud Console with the
# https://www.googleapis.com/auth/calendar scope, then obtain a refresh token
# (e.g. via https://developers.google.com/oauthplayground).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
